        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@, line %@ to %@. Departs in %lld min"
          }
        }
      }
    },
    "%@, línea %@ hacia %@. Ya ha salido" : {
      "comment" : "Horarios: lectura de VoiceOver de una salida que ya ha pasado; hora, línea y destino.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@, line %2$@ to %3$@. Already departed"
