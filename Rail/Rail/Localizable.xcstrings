{
  "sourceLanguage" : "es",
  "strings" : {
    "¡Vaya! Parece que aún no tienes estaciones favoritas…" : {
      "comment" : "Favoritos: título cuando todavía no hay ninguna estación favorita.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oops! Looks like you don’t have any favorite stations yet…"
          }
        }
      }
    },
    "¿A dónde quieres ir?" : {
      "comment" : "Trayectos: título grande encima del buscador de trenes.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Where do you want to go?"
          }
        }
      }
    },
    "%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "Cabecera de sección de una tarjeta: título seguido de un detalle, por ejemplo «Próximos trenes · programados».",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ · %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Mapa: lectura de VoiceOver de la espera de un tren seguida de su retraso, por ejemplo «5 min, con 3 minutos de retraso».",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@, %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, línea %@ hacia %@" : {
      "comment" : "Horarios: lectura de VoiceOver de una salida; hora, línea y destino.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@, line %2$@ to %3$@"
